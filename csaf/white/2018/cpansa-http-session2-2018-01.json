   "vulnerabilities": [
      {
         "cve": "CVE-2018-25160",
         "cwe": {
            "id": "CWE-20",
            "name": "Improper Input Validation"
         },
         "notes": [
            {
               "category": "description",
               "text": "HTTP::Session2 versions through 1.09 for Perl does not validate the format of user provided session ids, enabling code injection or other impact depending on session backend.\n\nFor example, if an application uses memcached for session storage, then it may be possible for a remote attacker to inject memcached commands in the session id value.",
               "title": "Vulnerability Description"
            }
         ],
