         {
            "category": "description",
            "text": "Net::Statsd::Tiny versions before 0.3.8 for Perl allowed metric injections.  The metric names and set values were not checked for newlines, colons or pipes. Metrics generated from untrusted sources could inject additional statsd metrics.",
            "title": "Vulnerability Description"
         }
