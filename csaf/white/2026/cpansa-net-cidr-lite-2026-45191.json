      "notes": [
         {
            "category": "description",
            "text": "Net::CIDR::Lite versions before 0.24 for Perl does not properly consider extraneous zero characters in CIDR mask values, which may allow IP ACL bypass.  Mask forms like \"/00\" and \"/01\" pass validation and parse to the same prefix as their unpadded value.  See also CVE-2026-45190.",
            "title": "Vulnerability Description"
         }
      ],
