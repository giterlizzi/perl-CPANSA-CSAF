      "notes": [
         {
            "category": "description",
            "text": "Web::Passwd versions through 0.03 for Perl is vulnerable to RCE.  Web::Passwd is a small CGI application for managing htpasswd files using the htpasswd command.  The user parameter is not validated or escaped, and is used as the last argument on the command line, allowing for command injection.",
            "title": "Vulnerability Description"
         }
      ],
