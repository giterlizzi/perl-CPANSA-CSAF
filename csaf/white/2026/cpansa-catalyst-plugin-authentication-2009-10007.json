      "notes": [
         {
            "category": "description",
            "text": "Catalyst::Plugin::Authentication versions before 0.10_027 for Perl is susceptible to session fixation attacks.  Catalyst::Plugin::Authentication does not automatically change the session id after authentication. An attacker that obtains a session id cookie can use this to impersonate the victim.",
            "title": "Vulnerability Description"
         }
      ],
