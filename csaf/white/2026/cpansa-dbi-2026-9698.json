      "notes": [
         {
            "category": "description",
            "text": "DBI versions before 1.648 for Perl saved errors in a limited-sized buffer.  Error messages that were returned when RaiseError, PrintError or HandleError were set were written to a 200-byte buffer without a length limit.  Attackers that can influence the error text in an application can trigger a buffer overflow.",
            "title": "Vulnerability Description"
         }
      ],
