      "notes": [
         {
            "category": "description",
            "text": "Net::Statsd::Lite versions through 0.10.0 for Perl allowed metric injections.  The values from the set_add method were not checked for newlines, colons or pipes. Metrics generated from untrusted sources could inject additional statsd metrics.  Note that version 0.9.0 fixed a similar issue CVE-2026-46719 for metric names.",
            "title": "Vulnerability Description"
         }
      ],
