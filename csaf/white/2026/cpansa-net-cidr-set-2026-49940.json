      "notes": [
         {
            "category": "description",
            "text": "Net::CIDR::Set versions through 0.20 for Perl accept non-ASCII IP addresses and netmasks.  Unicode digits such as the Arabic-Indic One (U+0661) were accepted but not properly parsed as numbers.  This could allow network masks to accept larger networks.",
            "title": "Vulnerability Description"
         }
      ],
