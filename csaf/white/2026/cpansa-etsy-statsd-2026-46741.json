      "notes": [
         {
            "category": "description",
            "text": "Etsy::StatsD versions through 1.002002 for Perl allow metric injections.  The metric names and values are not checked for newlines, colons or pipes. Metrics generated from untrusted sources could inject additional statsd metrics.  Note that the git repository contains an unreleased version with the gauge and set methods that also do not check for potential metric injections.",
            "title": "Vulnerability Description"
         }
      ],
