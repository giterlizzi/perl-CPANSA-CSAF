      "notes": [
         {
            "category": "description",
            "text": "DBI versions before 1.650 for Perl have a heap overflow when preparsing SQL statements with an extreme number of placeholders.  The fix for CVE-2026-10879 did not allocate enough memory to handle approximately 1.2-million placeholders.  DBI version 1.650 sets a hard limit of 99,999 placeholders.",
            "title": "Vulnerability Description"
         }
      ],
