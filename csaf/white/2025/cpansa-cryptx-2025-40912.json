      "notes": [
         {
            "category": "description",
            "text": "CryptX for Perl before version 0.065 contains a dependency that may be susceptible to malformed unicode.  CryptX embeds the tomcrypt library. The versions of that library in CryptX before 0.065 may be susceptible to CVE-2019-17362.",
            "title": "Vulnerability Description"
         }
      ],
