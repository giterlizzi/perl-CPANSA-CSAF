         ]
      },
      {
         "cve": "CVE-2023-0437",
         "cwe": {
            "id": "CWE-835",
            "name": "Loop with Unreachable Exit Condition ('Infinite Loop')"
         },
         "notes": [
            {
               "category": "description",
               "text": "When calling bson_utf8_validate on some inputs a loop with an exit condition that cannot be reached may occur, i.e. an infinite loop. This issue affects All MongoDB C Driver versions prior to versions 1.25.0.",
               "title": "Vulnerability Description"
            }
         ],
         "product_status": {
            "known_affected": [
               "CSAFPID-0001"
            ]
         },
