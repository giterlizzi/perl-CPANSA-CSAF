      "lang": "en",
      "notes": [
         {
            "category": "description",
            "text": "Net::Dropbox::API 1.9 and earlier for Perl uses the rand() function as the default source of entropy, which is not cryptographically secure, for cryptographic functions.  Specifically Net::Dropbox::API uses the Data::Random library which specifically states that it is \"Useful mostly for test programs\". Data::Random uses the rand() function.",
            "title": "Vulnerability Description"
         }
      ],
